<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.ai"
    >

  <adapter
      factory=".ai.AIControlpanel"
      name="ai-settings"
      />

  <browser:page
      name="ai-settings"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".ai.AISettingsControlPanel"
      permission="cmf.ManagePortal"
      />

  <!-- JSON ↔ list converter for the models widget. -->
  <adapter factory=".widgets.AIModelsDataConverter" />

</configure>
