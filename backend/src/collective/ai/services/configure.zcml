<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.ai"
    >

  <plone:service
      method="POST"
      factory=".list_models.ListAIModels"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.ManagePortal"
      name="@ai-list-models"
      />

  <plone:service
      method="POST"
      factory=".model_capabilities.GetAIModelCapabilities"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.ManagePortal"
      name="@ai-model-capabilities"
      />

  <plone:service
      method="POST"
      factory=".ai.AIServiceEndpoint"
      for="plone.dexterity.interfaces.IDexterityContent"
      permission="zope2.View"
      name="@ai"
      />

  <plone:service
      method="GET"
      factory=".task_status.AITaskStatus"
      for="plone.dexterity.interfaces.IDexterityContent"
      permission="zope2.View"
      name="@ai-task"
      />

</configure>
